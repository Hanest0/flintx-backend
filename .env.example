# ═══════════════════════════════════════════════════════════════════════
# FlintX Backend — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to git. Add .env to your .gitignore.
# ═══════════════════════════════════════════════════════════════════════

# ── Core ──────────────────────────────────────────────────────────────
ENVIRONMENT=development              # development | production
FRONTEND_URL=http://localhost:3000   # production: https://flintx.tv

# ── Database ──────────────────────────────────────────────────────────
# Local: SQLite (no setup — just works)
DATABASE_URL=sqlite:///./flintx_local.db
# Production: Supabase PostgreSQL
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── Security ──────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE-THIS-minimum-64-character-random-string-in-production

# ── AWS ───────────────────────────────────────────────────────────────
# IAM user needs: AmazonS3FullAccess, AmazonRekognitionReadOnlyAccess,
#                 AWSElementalMediaConvertFullAccess
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# S3 bucket for video storage
S3_BUCKET=flintx-videos

# CloudFront CDN domain (without https://)
CLOUDFRONT_DOMAIN=d1234567890.cloudfront.net

# MediaConvert — get endpoint from AWS Console → MediaConvert → Get endpoint
MEDIACONVERT_ENDPOINT=https://xxxxxx.mediaconvert.us-east-1.amazonaws.com
MEDIACONVERT_ROLE=arn:aws:iam::123456789012:role/FlintXMediaConvertRole

# ── OpenAI ────────────────────────────────────────────────────────────
# platform.openai.com → API keys → Create new key
# Powers: Script Writer, Opportunity AI, moderation
OPENAI_API_KEY=sk-your-openai-key

# ── ElevenLabs ────────────────────────────────────────────────────────
# elevenlabs.io → Profile → API key
# Powers: Voice Generator
ELEVENLABS_API_KEY=your-elevenlabs-key

# ── PayPal ────────────────────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Create App
PAYPAL_MODE=sandbox                  # sandbox | live
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-webhook-id
PAYPAL_SKIP_VERIFY=true              # false in production

# PayPal Subscription Plan IDs (create at developer.paypal.com → Subscriptions)
PAYPAL_PLAN_STUDIO_BASIC_M=P-XXXXXXXX      # $29.00/mo
PAYPAL_PLAN_STUDIO_PRO_M=P-XXXXXXXX        # $59.00/mo
PAYPAL_PLAN_STUDIO_AGENCY_M=P-XXXXXXXX     # $149.00/mo
PAYPAL_PLAN_STUDIO_BASIC_A=P-XXXXXXXX      # $232.00/yr
PAYPAL_PLAN_STUDIO_PRO_A=P-XXXXXXXX        # $472.00/yr
PAYPAL_PLAN_STUDIO_AGENCY_A=P-XXXXXXXX     # $1,192.00/yr
PAYPAL_PLAN_PASS_M=P-XXXXXXXX              # $9.99/mo
PAYPAL_PLAN_PASS_A=P-XXXXXXXX              # $79.99/yr

# ── Wise Business (Creator Payouts) ───────────────────────────────────
# wise.com/business → Settings → API tokens
WISE_MODE=sandbox                    # sandbox | live
WISE_API_KEY=your-wise-api-key
WISE_PROFILE_ID=your-wise-profile-id

# ── Email (Resend) ────────────────────────────────────────────────────
# resend.com → API Keys → Create Key
# Free: 3,000 emails/month
RESEND_API_KEY=re_your-resend-key
FROM_EMAIL=noreply@flintx.tv

# ── Currency Exchange Rates ───────────────────────────────────────────
# openexchangerates.org → Sign up → Free (1,000 req/month)
# Without this, FlintX uses hardcoded fallback rates (still works)
OPEN_EXCHANGE_RATES_APP_ID=your-oxr-app-id

# ── Live Streaming ────────────────────────────────────────────────────
# RTMP ingest server URL (nginx-rtmp on your server or AWS IVS)
RTMP_INGEST_URL=rtmp://ingest.flintx.tv/live
CDN_URL=https://cdn.flintx.tv
LIVESTREAM_WEBHOOK_SECRET=change-this-to-random-string

# ── Redis (optional — APScheduler background jobs) ───────────────────
# Free: Redis Cloud at redis.com
REDIS_URL=redis://localhost:6379/0
