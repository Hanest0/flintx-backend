# FlintX Backend — Environment Variables
# Set ALL of these in Railway → Variables → Raw Editor

# ── Core ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
SECRET_KEY=9ed3de12b47d0313abdb3294196ad838b008b3e6c2bf9440ba801e8a323ec1f2
FRONTEND_URL=https://vdm-technology.vercel.app
DATABASE_URL=sqlite:///./flintx.db

# ── AI Tools (Studio) ─────────────────────────────────────────────────
# Script Writer + Opportunity AI — get key at platform.openai.com
OPENAI_API_KEY=sk-your-key-here
# Voice Generator — get key at elevenlabs.io
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# ── Email ─────────────────────────────────────────────────────────────
# Email verification — get key at resend.com (free tier available)
RESEND_API_KEY=re_your-key-here

# ── Video Storage (AWS) ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET=flintx-videos
CLOUDFRONT_DOMAIN=your-distribution.cloudfront.net
MEDIACONVERT_ENDPOINT=https://your-endpoint.mediaconvert.us-east-1.amazonaws.com
MEDIACONVERT_ROLE=arn:aws:iam::123456789:role/FlintXMediaConvertRole

# ── Connected Apps OAuth ──────────────────────────────────────────────
CANVA_CLIENT_ID=your-canva-client-id
NOTION_CLIENT_ID=your-notion-client-id
SPOTIFY_CLIENT_ID=your-spotify-client-id
DISCORD_CLIENT_ID=your-discord-client-id
TWITTER_CLIENT_ID=your-twitter-client-id
GOOGLE_CLIENT_ID=your-google-client-id

# ── Payments ─────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_MODE=sandbox
WISE_API_KEY=your-wise-key
WISE_PROFILE_ID=your-wise-profile-id

# ── Security ─────────────────────────────────────────────────────────
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-fernet-key-here
